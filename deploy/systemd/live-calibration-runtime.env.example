# Non-secret values for the separate live calibration service only.
LIVE_CALIBRATION_PLAN=/opt/paper-trading/config/calibration/taker_micro_live_canary.yaml
LIVE_CALIBRATION_PYTHON_BIN=/opt/polyData/.venv/bin/python
POLY_QUANT_DISABLE_DOTENV=1
POLYDATA_POSTGRES_HOST=LIVE_CALIBRATION_DB_PRIVATE_HOST
POLYDATA_POSTGRES_PORT=5432
POLYDATA_POSTGRES_USER=poly_quant_live_calibration_app
POLYDATA_POSTGRES_DATABASE=poly_quant_live_calibration
POLYDATA_POSTGRES_SEARCH_PATH=quant,core,oracle,ops,public
# Non-secret account metadata used for fail-closed identity checks.
POLY_QUANT_PROBE_FUNDER_ADDRESS=0xREPLACE_WITH_APPROVED_FUNDER
POLYMARKET_SIGNATURE_TYPE=2
# LIVE_CALIBRATION_RUN_ID must identify an already prepared and approved run.
# LIVE_CALIBRATION_RUN_ID=
# LIVE_CALIBRATION_ASSET_ID=
