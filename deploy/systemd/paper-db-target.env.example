# Cloud SQL PostgreSQL private endpoint in the same GCP region as the worker.
# This file is non-secret. Put the password in the 0600 credential file
# ~/.config/prediction-market-quant/secrets/paper-db-target-password.
# Do not add POLYDATA_POSTGRES_* or PAPER_TARGET_POSTGRES_PASSWORD here;
# cutover generates a paper-worker-only active override after preflight passes.
PAPER_TARGET_POSTGRES_HOST=10.148.0.5
PAPER_TARGET_POSTGRES_PORT=5432
PAPER_TARGET_POSTGRES_USER=paper_authority
PAPER_TARGET_POSTGRES_DATABASE=paper_authority
PAPER_TARGET_POSTGRES_SEARCH_PATH=quant,core,oracle,ops,public
PAPER_TARGET_POSTGRES_CONNECT_TIMEOUT_SECONDS=5
PAPER_TARGET_POSTGRES_STATEMENT_TIMEOUT_MS=20000
PAPER_TARGET_POSTGRES_LOCK_TIMEOUT_MS=5000
