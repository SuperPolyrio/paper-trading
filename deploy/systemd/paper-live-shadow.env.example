# Paper execution uses the remote PostgreSQL control plane through an SSH tunnel.
# Keep these overrides scoped to the paper worker; L2 services use gcp-l2.env.
POLYDATA_QUANT_POSTGRES_CONNECT_TIMEOUT_SECONDS=10
POLYDATA_QUANT_POSTGRES_STATEMENT_TIMEOUT_MS=20000
PAPER_LIVE_DB_OPERATION_TIMEOUT_SECONDS=60
# The GCP launcher enables durable fill-finality observation by default.

# The health server binds to GCP loopback. Access it through SSH forwarding;
# do not expose it directly to the internet.
PAPER_HEALTH_HOST=127.0.0.1
PAPER_HEALTH_PORT=18700
PAPER_HEALTH_MAX_AGE_SECONDS=30
PAPER_WORKER_BUILD_MANIFEST=/opt/paper-trading/runtime_outputs/production/paper-worker-build.json

# The GCP launcher always enables database fencing. These values remain useful
# for local workers; GCP uses the PAPER_LIVE_* overrides below so an old env file
# cannot silently restore the original short lease.
PAPER_WORKER_AUTHORITY_PARTITION_KEY=paper-global
PAPER_WORKER_AUTHORITY_LEASE_SECONDS=60
PAPER_WORKER_AUTHORITY_HEARTBEAT_SECONDS=10
PAPER_WORKER_AUTHORITY_ENFORCE=1
PAPER_LIVE_AUTHORITY_LEASE_SECONDS=60
PAPER_LIVE_AUTHORITY_HEARTBEAT_SECONDS=10
