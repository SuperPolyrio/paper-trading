# Paper-only non-secret runtime configuration.
# Store the DB password in a 0600 systemd credential file named paper-db-password.
POLY_QUANT_DISABLE_DOTENV=1
POLYDATA_POSTGRES_HOST=127.0.0.1
POLYDATA_POSTGRES_PORT=5432
POLYDATA_POSTGRES_USER=poly_quant_paper_app
POLYDATA_POSTGRES_DATABASE=poly_data_core
POLYDATA_POSTGRES_SEARCH_PATH=quant,core,oracle,ops,public
PAPER_SECURITY_REQUIRE_DB_CREDENTIAL_FILE=1
PAPER_SECURITY_AUDIT_LOG=/mnt/l2-archive/.health/paper-live-shadow/security-audit.jsonl
PAPER_LIVE_STATUS_PATH=/mnt/l2-archive/.health/paper-live-shadow/status.json
PAPER_OPERATIONS_STATUS_PATH=/mnt/l2-archive/.health/paper-live-shadow/operations-status.json
PAPER_OPERATIONS_METRICS_PATH=/mnt/l2-archive/.health/paper-live-shadow/operations-metrics.prom
PAPER_OPERATIONS_ADMISSION_FLAG=--operations-admission-enforce
PAPER_UNIFIED_ADMISSION_FLAG=--unified-admission-shadow
